{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BZI visual asset consumer manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "slots"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string"
    },
    "slots": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "enabled",
          "authorized"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "authorized": {
            "type": "boolean"
          },
          "path": {
            "type": "string",
            "pattern": "^/?assets/[A-Za-z0-9_./-]+\\.(png|webp|jpg|jpeg)$"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4194304
          },
          "alt": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}